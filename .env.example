# VoltDrop environment variables (spec §18). Validated with zod at start-up: the API and worker
# refuse to boot on invalid config (apps/api/src/config/env.ts).
#
# Local development needs no .env at all: with APP_ENV=local every value below is the default.
# To override something locally, copy this file to .env (git-ignored) and change only what you need.
# Values here are local-only placeholders, never secrets. Outside local nothing has a default.

# Core
APP_ENV=local                      # local | staging | production
NODE_ENV=development               # development | test | production
API_PORT=4000                      # port the API listens on (added in M0)
LOG_LEVEL=info                     # fatal | error | warn | info | debug | trace | silent (added in M0)
API_BASE_URL=http://localhost:4000
CUSTOMER_WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
MERCHANT_PORTAL_URL=http://localhost:5174

# Client apps (added in M0). Bundlers only expose prefixed variables to client code, so each kind of
# app reads its own name; all three hold the API's public URL. The apps read them at build time from
# their own folder's .env or the environment, and default to http://localhost:4000.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000   # customer-app, merchant-app
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000   # customer-web
VITE_API_BASE_URL=http://localhost:4000          # merchant-portal, admin

# Data
DATABASE_URL=postgres://voltdrop:voltdrop@localhost:5432/voltdrop
DATABASE_READONLY_URL=
REDIS_URL=redis://localhost:6379
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=local-dev-typesense-key
S3_ENDPOINT=http://localhost:9000  # SeaweedFS S3 API locally; leave empty in AWS
S3_REGION=eu-west-2
S3_BUCKET_PUBLIC=voltdrop-public
S3_BUCKET_PRIVATE=voltdrop-private
S3_ACCESS_KEY_ID=voltdrop-local    # empty in AWS: the task's IAM role is used
S3_SECRET_ACCESS_KEY=voltdrop-local-secret
FIELD_ENCRYPTION_KEY=local-only-field-encryption-key-never-use-outside-dev  # local only; KMS in cloud environments

# Auth
AUTH_SECRET=local-only-auth-secret-never-use-outside-dev  # at least 32 characters; rejected outside local
AUTH_TRUSTED_ORIGINS=              # comma-separated
ADMIN_OIDC_ISSUER=
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_CLIENT_SECRET=

# Payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Delivery
DELIVERY_PROVIDER=mock             # mock | uber_direct
UBER_DIRECT_CUSTOMER_ID=
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_WEBHOOK_SECRET=

# Geo and addresses
GEO_PROVIDER=mock                  # mock | google
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_WEB_KEY=
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
ADDRESS_PROVIDER=fixture           # fixture | ideal_postcodes
IDEAL_POSTCODES_API_KEY=

# Product and company data
PRODUCT_DATA_PROVIDER=fixture      # fixture | icecat
ICECAT_USERNAME=
ICECAT_API_KEY=
COMPANY_REGISTRY_PROVIDER=fixture  # fixture | companies_house
COMPANIES_HOUSE_API_KEY=

# AI (model IDs verified against the Anthropic documentation on 2026-09-11)
LLM_PROVIDER=fake                  # fake | anthropic
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-4-5-20251001
CATALOGUE_MODEL=claude-sonnet-5

# Messaging
EMAIL_PROVIDER=smtp                # smtp | postmark
SMTP_URL=smtp://localhost:1025     # Mailpit; the inbox is at http://localhost:8025
POSTMARK_SERVER_TOKEN=
EMAIL_FROM="VoltDrop <orders@voltdrop.example>"
PUSH_PROVIDER=log                  # log | expo
EXPO_ACCESS_TOKEN=
TELEPHONY_PROVIDER=log             # log | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Observability and analytics
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SENTRY_DSN_MOBILE=
OTEL_EXPORTER_OTLP_ENDPOINT=
POSTHOG_KEY=
POSTHOG_HOST=                      # PostHog EU cloud host
