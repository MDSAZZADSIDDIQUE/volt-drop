{
  "name": "@voltdrop/api",
  "version": "0.0.0",
  "private": true,
  "description": "VoltDrop API and worker: a NestJS modular monolith (spec §4, §5).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "start": "node --enable-source-maps --import ./dist/instrumentation.js dist/main.js",
    "start:worker": "node --enable-source-maps --import ./dist/instrumentation.js dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-ioredis": "0.70.0",
    "@opentelemetry/instrumentation-pg": "0.74.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@voltdrop/domain": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "graphile-worker": "0.18.0",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@readme/openapi-parser": "9.0.0",
    "@swc/core": "1.16.2",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@voltdrop/config": "workspace:*",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "supertest": "7.2.2",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3",
    "unplugin-swc": "1.6.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
