{
  "name": "@voltdrop/customer-app",
  "version": "0.0.0",
  "private": true,
  "description": "VoltDrop customer app for iOS and Android (Expo SDK 57, spec §4). Product screens arrive in M7.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --port 8081",
    "build": "expo export --platform android --platform ios --output-dir dist",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.15",
    "@tanstack/react-query": "5.102.8",
    "@voltdrop/api-client": "workspace:*",
    "expo": "57.0.21",
    "expo-constants": "57.0.17",
    "expo-linking": "57.0.9",
    "expo-router": "57.0.20",
    "expo-status-bar": "57.0.1",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.6",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@voltdrop/config": "workspace:*",
    "babel-preset-expo": "57.0.11",
    "eslint": "10.10.0",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3"
  }
}
