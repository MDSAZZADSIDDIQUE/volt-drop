{
  "openapi": "3.1.0",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The API process is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "summary": "Liveness",
        "tags": [
          "platform"
        ]
      }
    },
    "/v1/ready": {
      "get": {
        "operationId": "getReadiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Ready to take traffic. \"degraded\" means search (Typesense) is down.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "PostgreSQL, the migrations or Valkey is down. The problem lists every check in `checks`."
          }
        },
        "summary": "Readiness",
        "tags": [
          "platform"
        ]
      }
    }
  },
  "info": {
    "title": "VoltDrop API",
    "description": "REST API for the VoltDrop apps. Errors are RFC 9457 problem details (application/problem+json).",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "degraded"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "postgres": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ]
              },
              "migrations": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ]
              },
              "valkey": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ]
              },
              "typesense": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ]
              }
            },
            "required": [
              "postgres",
              "migrations",
              "valkey",
              "typesense"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "additionalProperties": false
      }
    }
  }
}
