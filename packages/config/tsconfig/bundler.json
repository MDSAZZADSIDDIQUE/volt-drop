{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "VoltDrop bundled React (Vite and shared UI packages)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": []
  }
}
