{
  "name": "@voltdrop/domain",
  "version": "0.0.0",
  "private": true,
  "description": "Shared business logic: money, VAT, ids, references, state machines and schemas (spec §5).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./money": {
      "types": "./dist/money/index.d.ts",
      "default": "./dist/money/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "uuid": "14.0.2",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@vitest/coverage-v8": "4.1.11",
    "@voltdrop/config": "workspace:*",
    "eslint": "10.10.0",
    "fast-check": "4.9.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
