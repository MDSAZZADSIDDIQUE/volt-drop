{
  "name": "@voltdrop/ui-web",
  "version": "0.0.0",
  "private": true,
  "description": "VoltDrop web components, styled with the ui-tokens utilities (spec §9, ADR-0018).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "react": "~19.2.3"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@voltdrop/config": "workspace:*",
    "eslint": "10.10.0",
    "jsdom": "30.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
